# Server-side configuration. Never put real secrets in this example file.
STUDIO_DIR=/workspace
COMFY_URL=http://127.0.0.1:18188
STUDIO_HOST=127.0.0.1
STUDIO_PORT=7860
STUDIO_AUTO_INSTALL=1
STUDIO_PREVIEW_PROXY=1

# Paid H3 calls require explicit enablement AND your own provider credential.
MINIMAX_ENABLED=0
MINIMAX_API_KEY=

# Optional existing local/OpenAI-compatible narrative model.
LLM_URL=http://127.0.0.1:11434/v1
LLM_MODEL=

# Optional cloud OAuth; existing UI and encrypted credential handling remain.
GOOGLE_OAUTH_CLIENT_FILE=/workspace/google_oauth_client.json
GOOGLE_OAUTH_PORT=7862

# Set both only when Gradio authentication is required.
STUDIO_USER=
STUDIO_PASSWORD=
